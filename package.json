{
  "name": "@xuanyi-king/dsh-theme-gallery",
  "version": "0.3.21",
  "description": "DeepSeek Harness theme center with eleven themes and safe update checks",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/THEME-CENTER-UPGRADE-DESIGN.md",
    "docs/THEME-CENTER-ACCEPTANCE.md"
  ],
  "workspaces": [
    "themes/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces && node scripts/build-gallery.mjs",
    "test": "npm run test --workspaces && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test",
    "pack:gallery": "npm run build && npm pack --workspaces=false",
    "pack:shanhe": "npm pack -w themes/shanhe",
    "pack:ultraman": "npm pack -w themes/ultraman",
    "pack:perfect-world": "npm pack -w themes/perfect-world",
    "pack:flame-emperor": "npm pack -w themes/flame-emperor",
    "pack:great-sage": "npm pack -w themes/great-sage",
    "pack:nezha": "npm pack -w themes/nezha",
    "pack:whale-prince": "npm pack -w themes/whale-prince",
    "pack:jianlai-aliang": "npm pack -w themes/jianlai-aliang",
    "pack:sunny-watch": "npm pack -w themes/sunny-watch",
    "pack:young-goku": "npm pack -w themes/young-goku"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dependencies": {
    "semver": "7.8.5",
    "js-yaml": "4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.2.0-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuanyi-king/dsh-theme-gallery.git"
  },
  "homepage": "https://github.com/Xuanyi-king/dsh-theme-gallery#readme",
  "bugs": {
    "url": "https://github.com/Xuanyi-king/dsh-theme-gallery/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "theme",
    "themes",
    "cordis"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
