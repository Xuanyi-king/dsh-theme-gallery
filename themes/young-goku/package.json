{
  "name": "dsh-young-goku-theme",
  "version": "0.1.0",
  "description": "Unofficial Young Goku Nimbus fan theme for DeepSeek Harness Web",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-theme"] }
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test test/*.test.mjs" }
}
